// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/05/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM == 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to restart the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
        // https://github.com/yuki0920/nand2tetris/blob/main/projects/05/CPU.hdl

        // instruction[15] == 0 の場合は A 命令
        // そうでないならば C 命令
        Not(in=instruction[15], out=aInstruction);
        Not(in=aInstruction, out=cInstruction);

        /**
         * A レジスタの処理を行う
         */
        // C 命令 かつ 命令プログラム[5] = 1 であれば  ALU の計算結果を A レジスタに格納しろフラグ
        And(a=cInstruction, b=instruction[5], out=ALUtoAFlag);
        // ALUtoAFlag が 1 なら, 前回ステップの ALUout の出力結果を A レジスタに保存する
        // そうでないならば A 命令であるとして instruction をそのまま A レジスタに流す
        Mux16(a=instruction, b=ALUout, sel=ALUtoAFlag, out=aRegisterAddress);

        // A 命令か A レジスタに格納フラグが経っていたら A レジスタに記録する
        Or(a=aInstruction, b=ALUtoAFlag, out=loadA);
        // A レジスタにそのまま 16 bit in にいれる
        // loadA であれば aRegisterAddress を記憶させる
        ARegister(in=aRegisterAddress, load=loadA, out=Aout);

        /**
         * D レジスタの処理を行う
         */
        // A 命令かつ 命令プログラム[4] = 1 であれば、 D レジスタの値を保存する
        And(a=cInstruction, b=instruction[4], out=loadD);
        // D レジスタを保存する
        DRegister(in=ALUout, load=loadD, out=Dout);

        /*
         * ALU の計算を行う
         */
        // A レジスタを使うか M レジスタ（=メモリ入力）を使うか
        // どちらにしても D レジスタの値はともに利用する
        Mux16(a=Aout, b=inM, sel=instruction[12], out=AMout); 
        // 命令プログラム[6..11] 中間 6 bit の値で、 A, M, D レジスタから適切に値を取り出して計算する
        // 計算結果は out に出す
        ALU(
            x=Dout, 
            y=AMout, 
            zx=instruction[11], 
            nx=instruction[10], 
            zy=instruction[9], 
            ny=instruction[8], 
            f=instruction[7], 
            no=instruction[6], 
            out=ALUout, 
            zr=ZRout, 
            ng=NGout
        ); 

        /*
        * RAMメモリに書き込む
        *
        * ALU による「メモリ書き込み」処理と 「命令データフェッチ（プログラムカウンタ）」処理が同じステップで両方走る
        * RAMメモリ読み書きと ROM命令読み込むが同時に行われていてすごい
        */
        // 次ステップで RAM に書き込むアドレスを指定する
        Or16(a=false, b=Aout, out[0..14]=addressM);
        // ALU の計算結果 (RAM に保存される値)
        Or16(a=false, b=ALUout, out=outM);
        // 次ステップで メモリに保存するか？
        And(a=cInstruction, b=instruction[3], out=writeM);

        /*
        * プログラムカウンタ
        */
        // jump は下位 3 bit [0..2] で判定される
        And(a=ZRout, b=instruction[1], out=jeq);
        And(a=NGout, b=instruction[2], out=jlt);
        Or(a=ZRout, b=NGout, out=zeroOrNeg);
        Not(in=zeroOrNeg, out=positive);
        And(a=positive, b=instruction[0], out=jgt);
        Or(a=jeq, b=jlt, out=jle);
        Or(a=jle, b=jgt, out=jumpToA);
        // c命令かつ 「A レジスタで飛ぶ」判定であれば PCload=1 にする
        And(a=cInstruction, b=jumpToA, out=PCload);
        Not(in=PCload, out=PCinc);
        // PCload=1 であれば Aout に強引に飛ばす
        // そうでないのであれば PCint=1 のため 1 だけインクリメントされる（次の命令が呼ばれる）
        PC(in=Aout, inc=PCinc, load=PCload, reset=reset, out[0..14]=pc);
}
