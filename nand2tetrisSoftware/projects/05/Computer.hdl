// File name: projects/05/Computer.hdl
/**
 * The Hack computer, consisting of CPU, ROM and RAM.
 * When reset is 0, the program stored in the ROM executes.
 * When reset is 1, the program's execution restarts. 
 * Thus, to start running the currently loaded program,
 * set reset to 1, and then set it to 0. 
 * From this point onwards, the user is at the mercy of the software:
 * Depending on the program's code, and whether the code is correct,
 * the screen may show some output, the user may be expected to enter
 * some input using the keyboard, or the program may do some procerssing. 
 */
CHIP Computer {
    IN reset;

    PARTS:
        /*
         * Computer は 
         * - ROM(命令アドレス)
         * - RAM(データメモリ + I/Oメモリマップ)
         * - CPU
         * があれば自動で「ROM から命令データを CPU.pc をもとに取り出し」、CPU で処理した内容を RAM に保存する
         */

        // ROM はプログラムカウンタの値をもとに、該当アドレスの命令データを取り出す
        // 命令データも 2^16 のビットで表される
        // CPU で命令データは処理されるため、該当の CPU のプロトコルに沿ったバイナリデータにする必要がある
        ROM32K(address=pcOut, out=instruction);

        // 読み込んだメモリと命令データをもとに、 ALU で計算処理を行う
        // 次に読み出したい命令アドレスはプログラムカウンタに入っており ROM32K に流す
        // 次に読み出したいメモリアドレスは、 Memory に流す
        CPU(inM=memoryOut, instruction=instruction, reset=reset, outM=outM, writeM=writeM, addressM=addressM, pc=pcOut);

        /*
        * in = 書き込みたい値
        * load = 書き込み（記録）を行うか？
        * address = 書き込む場所
        */
        Memory(in=outM, load=writeM, address=addressM, out=memoryOut);
}
