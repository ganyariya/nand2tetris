// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/05/Memory.hdl
/** 
 * The Memory chip implements the complete address space of the Hack data memory,
 * including RAM, memory mapped screen, and memory mapped keyboard.
 * Outputs the value of the memory location specified by the address input.
 * If (load == 1), sets the memory location specified by the address input
 * to the value of the in input.
 * Address space rules:
 * Only the upper 16K + 8K + 1 words of the memory are used.
 * Access to address 0 to 16383 (0x0000 to 0x3FFF) results in accessing the RAM;
 * Access to address 16384 to 24575 (0x4000 to 0x5FFF) results in accessing the Screen memory map;
 * Access to address 24576 (0x6000) results in accessing the Keyboard memory map.
 */ 
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    /**
     * 15 bit からなるアドレス
     * ??1111111111111
     * - 0 ~ 16383 の場合: (01)1 1111 1111 1111
     * - 16384 ~ 24575 の場合: (10)1 1111 1111 1111
     *   - 下 13 桁で「SCREEN 内の絶対アドレス」を指定している
     *   - (10) を上位につけることで、 `Memory` 内での相対アドレスにしている
     * 24576 の場合: (11)0 0000 0000 0000
     */
    // Dmux4Way で `load` の値を、選択された MemoryMap IO にだけ渡す
    DMux4Way(in=load, sel=address[13..14], a=l1, b=l2, c=l3, d=l4);

    // l1, l2 (00 or 01) の場合は RAM を選択している
    Or(a=l1, b=l2, out=loadram);
    RAM16K(in=in, load=loadram, address=address[0..13], out=outram);

    // Screen 内の絶対アドレスは `[0..12]` で指定している
    // 上位 2 桁 `(10)` を上位につけることで、 Memory 内の相対アドレスにしている
    Screen(in=in, load=l3, address=address[0..12], out=outscreen);
    Keyboard(out=outkeyboard);

    Mux4Way16(a=outram, b=outram, c=outscreen, d=outkeyboard, sel=address[13..14], out=out);
}
